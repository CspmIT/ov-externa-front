pipeline {
  agent any
  stages {
    stage('clone repository') {
      steps {
        sh '''git --version'''
      }
    }

    stage('Deploy react-app') {
      steps {
        withCredentials(bindings: [
                      string(credentialsId: 'kubernete-jenkis-server-account', variable: 'api_token')
                      ]) {
                       sh '''kubectl --token $api_token --server https://168.196.255.154:6443 --insecure-skip-tls-verify=true get deployment ovexterna -n default
                          if [ $? -eq 0 ]
                          then
                              echo "Deployment exists, updating..."
                              kubectl --token $api_token --server https://168.196.255.154:6443 --insecure-skip-tls-verify=true rollout restart -n default deployment ovexterna
                          else
                              echo "Deployment does not exist, creating..."
                              kubectl --token $api_token --server https://168.196.255.154:6443 --insecure-skip-tls-verify=true apply -f deployment-ovexterna-jenkins.yaml
                              kubectl --token $api_token --server https://168.196.255.154:6443 --insecure-skip-tls-verify=true apply -f service-ovexterna.yaml
                          fi
                              kubectl --token $api_token --server https://168.196.255.154:6443 --insecure-skip-tls-verify=true apply -f ingress-ovexterna-jenkins.yaml'''
        }

        }
      }

    }
  }